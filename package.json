{
  "name": "pi-continue",
  "version": "0.0.0",
  "private": true,
  "description": "Pi extension: start each continuation in a fresh session linked to its source, with read-only retrieval of prior history.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "ultracite": "8.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
