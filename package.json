{
  "name": "@bjoernaagaard/pi-continue",
  "version": "0.1.0",
  "description": "Pi extension: start each continuation in a fresh session linked to its source, with read-only retrieval of prior history.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/bjoernaagaard/pi-continue#readme",
  "bugs": {
    "url": "https://github.com/bjoernaagaard/pi-continue/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjoernaagaard/pi-continue.git"
  },
  "files": [
    "skills",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "ultracite": "^8.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
